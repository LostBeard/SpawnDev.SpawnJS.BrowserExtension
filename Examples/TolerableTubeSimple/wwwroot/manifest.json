{
  "manifest_version": 3,
  "name": "TolerableTubeSimple",
  "version": "1.0",
  "description": "TolerableTubeSimple demonstrates SpawnDev.SpawnJS.BrowserExtension and SpawnDev.SpawnJS.RazorUI.",
  "icons": {
    "128": "app/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.youtube-nocookie.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://*.youtube-nocookie.com/*"
      ],
      "js": [ "app/content.js" ],
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://*.youtube-nocookie.com/*"
      ],
      "resources": [ "app/*" ]
    }
  ]
}
