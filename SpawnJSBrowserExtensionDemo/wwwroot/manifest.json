{
  "manifest_version": 3,
  "name": "SpawnJSBrowserExtensionDemo",
  "version": "1.0",
  "description": "SpawnJSBrowserExtensionDemo demonstrates SpawnDev.SpawnJS.BrowserExtension.",
  "icons": {
    "128": "app/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [ "<all_urls>" ],
      "js": [ "app/content.js" ],
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [ "<all_urls>" ],
      "resources": [ "app/*" ]
    }
  ]
}
